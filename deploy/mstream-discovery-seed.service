# systemd unit for a community seed node.
#   sudo cp mstream-discovery-seed /usr/local/bin/
#   sudo useradd --system --home /var/lib/mstream-seed mstream-seed
#   sudo mkdir -p /var/lib/mstream-seed && sudo chown mstream-seed: /var/lib/mstream-seed
#   sudo cp deploy/mstream-discovery-seed.service /etc/systemd/system/
#   sudo systemctl enable --now mstream-discovery-seed
#   journalctl -u mstream-discovery-seed -f     # watch for "neighbors=N"
[Unit]
Description=mStream discovery network seed node
After=network-online.target
Wants=network-online.target

[Service]
User=mstream-seed
ExecStart=/usr/local/bin/mstream-discovery-seed --data-dir /var/lib/mstream-seed
Restart=always
RestartSec=10
# Belt against slow leaks: a seed churns through more peer links than any
# other mesh member (it exists to be everyone's first contact), which is
# exactly the profile that turned the pre-leakfix iroh-gossip QUIC leak
# into a droplet-wide OOM elsewhere. Healthy RSS is ~30 MB; at 200 MB the
# service is killed and Restart=always brings it back in seconds — a
# bounded blip instead of the kernel OOM killer choosing a victim.
MemoryMax=200M
# Hardening — the seed needs nothing but the network and its data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mstream-seed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
